// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Rust",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},

	// GUI passthrough so `npm run tauri dev` opens a window outside VS Code
	// too. VS Code injects the display env and the wayland socket itself, so
	// without these GTK aborts with "Failed to initialize GTK" from tao.
	// XDG_RUNTIME_DIR=/tmp is what libwayland uses to resolve a relative
	// WAYLAND_DISPLAY, so the socket is mounted at /tmp/wayland-0.
	"runArgs": [
		"--ipc=host"
	],

	"initializeCommand": "touch ~/.devcontainer-xauth && ( [ -n \"$XAUTHORITY\" ] && [ -f \"$XAUTHORITY\" ] && cp -f \"$XAUTHORITY\" ~/.devcontainer-xauth || true )",

	// Use 'mounts' to make the cargo cache persistent in a Docker Volume.
	"mounts": [
		{
			"source": "/run/user/1000/${localEnv:WAYLAND_DISPLAY}",
			"target": "/tmp/wayland-0",
			"type": "bind"
		},
		{
			"source": "/tmp/.X11-unix",
			"target": "/tmp/.X11-unix",
			"type": "bind"
		},
		{
			"source": "${localEnv:HOME}/.devcontainer-xauth",
			"target": "/tmp/.devcontainer-xauth",
			"type": "bind"
		},
		{
			"source": "devcontainer-cargo-cache-${devcontainerId}",
			"target": "/usr/local/cargo",
			"type": "volume"
		},
		// Mount the app's XDG folders in named volumes so Tauri state persists
		// across container rebuilds. Volumes are cross-platform (Windows/macOS/Linux).
		{
			"source": "devcontainer-app-data-${devcontainerId}",
			"target": "/home/vscode/.local/share/eu.luxuride.singularity",
			"type": "volume"
		},
		{
			"source": "devcontainer-app-config-${devcontainerId}",
			"target": "/home/vscode/.config/eu.luxuride.singularity",
			"type": "volume"
		},
		{
			"source": "devcontainer-app-cache-${devcontainerId}",
			"target": "/home/vscode/.cache/eu.luxuride.singularity",
			"type": "volume"
		}
	],
	"containerEnv": {
		"WAYLAND_DISPLAY": "wayland-0",
		"XDG_RUNTIME_DIR": "/tmp",
		"GDK_BACKEND": "wayland",
		"DISPLAY": ":0",
		"XAUTHORITY": "/tmp/.devcontainer-xauth"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"tauri-apps.tauri-vscode",
				"svelte.svelte-vscode"
			]
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24",
			"pnpmVersion": "latest",
			"yarnVersion": "latest"
		}
	}

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "cargo --version"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
